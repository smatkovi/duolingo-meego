# Die Einstellungen, ohne die Rust hier nichts baut. Aus der Probe auf dem
# N950 (Kernel 2.6.32.54) belegt.
#
#   . tools/cross.env
#
# Warum musl und nicht glibc: Harmattan hat glibc 2.10, und ein Rust-Binary
# dagegen zu binden scheitert an Symbolen, die es dort nicht gibt. Statisch
# gegen musl umgeht das vollstaendig -- dasselbe Mittel wie CGO_ENABLED=0
# beim Go-Backend von harbour-whatsapp.
#
# Und musl bringt einen Vorteil mit, den Go nicht hat: seine accept4-
# Implementierung faellt auf accept zurueck, wenn der Kernel den Aufruf
# nicht kennt. Genau daran scheiterte das Go-Backend auf diesem Geraet.
export ZIEL=armv7-unknown-linux-musleabi
export RUSTUP_HOME=${RUSTUP_HOME:-/tmp/rust/rustup}
export CARGO_HOME=${CARGO_HOME:-/tmp/rust/cargo}
export PATH="$CARGO_HOME/bin:$PATH"

# Kisten mit C-Anteil brauchen einen Cross-C-Compiler MIT musl-Headern.
#
# clang allein reicht nicht, auch wenn es mit --target vordergruendig
# funktioniert: es findet dann /usr/include des Build-Rechners, also die
# x86-glibc-Header. Bei `ring` faellt das nicht auf, weil dessen C-Anteil
# kaum libc anfasst -- SQLite bindet stdio.h und pthread.h ein, und dann
# bricht es ab ("unsupported machine mode '__TC__'", "'regparm' is not
# valid on this platform"). Das sind keine ARM-Fehler, das sind x86-Header.
#
# Rust bringt zwar libc.a und die crt-Objekte fuer musl mit, aber keine
# Header. Deshalb eine fertige Cross-Toolchain von musl.cc; gelinkt wird
# weiterhin mit rust-lld gegen Rusts eigenes libc.a.
export MUSL=${MUSL:-/tmp/rust/arm-linux-musleabi-cross}
export CC_armv7_unknown_linux_musleabi="$MUSL/bin/arm-linux-musleabi-gcc"
export AR_armv7_unknown_linux_musleabi="$MUSL/bin/arm-linux-musleabi-ar"
export CFLAGS_armv7_unknown_linux_musleabi="-march=armv7-a -mfloat-abi=soft"
